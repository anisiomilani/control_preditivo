     float D = (pos_0_sq + pos_1_sq) - K * (neg_0_sq + neg_1_sq);
     float E = (pos_0_sq + pos_1_sq) + K * (neg_0_sq + neg_1_sq);

     float inv_D = 1.0f / (D != 0.0f ? D : LIMITAR_ZERO);
