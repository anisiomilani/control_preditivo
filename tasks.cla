            inv_D = 1.0f / D;
            inv_E = 1.0f / E;


            i2_ref_alfa_pos = DOIS_DIV_3*(((Vg_ab_filtrado_pos[0]*P_ref)*inv_D)  + ((Vg_ab_filtrado_pos[1]*Q_ref)*inv_E));
