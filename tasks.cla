//                  Constantes pré-calculadas para transformada de clark
//-------------------------------------------------------------------------------------------------------

#define DOIS_DIV_3 0.6666667f     // 2/3
#define TRES_DIV_2 1.5f           // 3/2
#define HALF 0.5f
#define SQRT3_BY_2 0.8660254f             // sqrt(3)/2

// Função reutilizável de Clarke
typedef struct {
    float alfa;
    float beta;
} ClarkeOutput;

ClarkeOutput ClarkeTransform(float a, float b, float c)
{
    ClarkeOutput out;
    out.alfa = DOIS_DIV_3 * (a - HALF * b - HALF * c);
    out.beta = DOIS_DIV_3 * (SQRT3_BY_2 * b - SQRT3_BY_2 * c);
    return out;
}

