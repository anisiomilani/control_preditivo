     i2_ref_neg[0] = DOIS_DIV_3 * ((-K * Vg_neg[0] * P_ref) * inv_D + (K * Vg_neg[1] * Q_ref) * inv_E);
     i2_ref_neg[1] = DOIS_DIV_3 * ((-K * Vg_neg[1] * P_ref) * inv_D - (K * Vg_neg[0] * Q_ref) * inv_E);

     i2_ref[0] = i2_ref_pos[0] + i2_ref_neg[0];
     i2_ref[1] = i2_ref_pos[1] + i2_ref_neg[1];

     // ========= Extrapolação da referência =========
     float i2_ref_ab[6], i2_ref_k2[2];
